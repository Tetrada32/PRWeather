<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="model"
            type="com.gahov.prweather.feature.details.entity.WeatherDetailsDataModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/weatherDetailsTopBackgroundView"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/grid_130"
            android:background="@color/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/grid_56"
            android:layout_height="@dimen/grid_56"
            android:layout_marginStart="@dimen/grid_5"
            android:layout_marginTop="@dimen/grid_5"
            android:scaleType="fitXY"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/weatherDetailsCardView"
            android:layout_width="0dp"
            android:layout_height="500dp"
            android:layout_marginHorizontal="@dimen/grid_35"
            android:layout_marginTop="@dimen/grid_80"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/weatherDetailsCityName"
                    style="@style/TextAppearance.PlanRadarWeather.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/grid_25"
                    android:gravity="center"
                    android:textColor="@color/black"
                    app:setText="@{model.locationName}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="London, Uk" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/weatherDetailsIcon"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    app:setImage="@{model.weatherIcon}"
                    app:layout_constraintBottom_toTopOf="@id/WeatherDetailsFieldList"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/weatherDetailsCityName"
                    tools:src="@drawable/ic_city" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/WeatherDetailsFieldList"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/grid_20"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_weather_details_data" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/weatherDetailsDate"
            style="@style/TextAppearance.PlanRadarWeather.Text.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/grid_10"
            android:layout_marginBottom="@dimen/grid_20"
            android:gravity="center"
            android:maxLines="2"
            app:setText="@{model.weatherDate}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Weather information for London received on 03.10.2019 - 11:28" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>