<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="presenter"
            type="com.gahov.prweather.feature.history.presenter.WeatherHistoryPresenter" />

        <variable
            name="model"
            type="com.gahov.prweather.feature.details.entity.WeatherDetailsDataModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="@dimen/grid_72"
        android:onClick="@{() -> presenter.onItemClick(model)}">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/itemWeatherHistoryIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_margin="@dimen/grid_25"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:setImage="@{model.weatherIcon}"
            tools:src="@drawable/ic_city" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/itemWeatherHistoryDate"
            style="@style/TextAppearance.PlanRadarWeather.Text.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/grid_21"
            android:layout_marginTop="@dimen/grid_16"
            android:textColor="@color/black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/itemWeatherHistoryIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:setText="@{model.requestTime}"
            tools:text="31, December - 23:59" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/itemWeatherHistoryMain"
            style="@style/TextAppearance.PlanRadarWeather.Subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/grid_25"
            android:layout_marginBottom="15dp"
            android:textColor="@color/black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/itemWeatherHistoryIcon"
            tools:text="+28 (c)" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>