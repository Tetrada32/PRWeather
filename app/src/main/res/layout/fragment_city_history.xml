<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="presenter"
            type="com.gahov.prweather.feature.history.presenter.WeatherHistoryPresenter" />

        <variable
            name="model"
            type="com.gahov.prweather.feature.details.entity.WeatherDetailsDataModel" />

        <variable
            name="title"
            type="com.gahov.prweather.arch.ui.view.model.TextProvider" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/baseHistoryListContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@null"
        android:fitsSystemWindows="false">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/historyListAppBarLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/grid_130"
            android:background="@color/colorPrimary"
            android:fitsSystemWindows="false">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/historyListCollapsingToolBarLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:animateLayoutChanges="false"
                app:collapsedTitleTextAppearance="@style/TextAppearance.AppCompat.Widget.ActionBar.Title.Inverse"
                app:contentScrim="@null"
                app:expandedTitleMarginEnd="@dimen/grid_64"
                app:expandedTitleMarginStart="@dimen/grid_72"
                app:expandedTitleTextAppearance="@style/TextAppearance.AppCompat.Widget.ActionBar.Title.Inverse"
                app:layout_scrollFlags="scroll|exitUntilCollapsed"
                tools:visibility="visible">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/historyListToolbarConstraintLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/colorPrimary"
                    app:layout_collapseMode="parallax">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/historyListTitle"
                        style="@style/TextAppearance.PlanRadarWeather.Headline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/grid_77"
                        android:layout_marginBottom="@dimen/grid_25"
                        android:ellipsize="end"
                        android:paddingStart="@dimen/grid_72"
                        android:paddingEnd="0dp"
                        android:text="@string/city_history_title"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_default="wrap"
                        app:setText="@{title}"
                        tools:text="London Historical" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/historyListToolbar"
            android:layout_width="match_parent"
            android:layout_height="?android:attr/actionBarSize"
            android:background="@color/colorPrimary"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lato_regular"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/grid_58"
                android:paddingEnd="@dimen/grid_58"
                android:textColor="@color/white"
                tools:text="London Historical" />
        </com.google.android.material.appbar.MaterialToolbar>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/grid_56"
            android:layout_height="@dimen/grid_56"
            android:layout_marginStart="@dimen/grid_5"
            android:layout_marginTop="@dimen/grid_5"
            android:onClick="@{() -> presenter.onBackButtonClick()}"
            android:scaleType="fitXY"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/history_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/grid_10"
            android:background="@null"
            android:clipToPadding="false"
            android:contentDescription="@null"
            android:fadeScrollbars="true"
            android:importantForAccessibility="noHideDescendants"
            android:overScrollMode="never"
            android:scrollbars="vertical"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            app:spanCount="2"
            tools:itemCount="30"
            tools:listitem="@layout/item_history"
            tools:visibility="visible" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>